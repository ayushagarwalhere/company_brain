# Copy to .env and fill in. Never commit .env.

# FalkorDB Cloud (from the instance's "Connect" panel)
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=company_brain

# Slack app with Socket Mode
# Bot token (xoxb-...): OAuth & Permissions page
#   scopes: channels:history, channels:read, chat:write, users:read, groups:history
# App token (xapp-...): Basic Information > App-Level Tokens, scope connections:write
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_CHANNEL_ID=

# Discord bot (Message Content Intent enabled in the Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# GitHub: public repo for the fictional company + a fine-grained PAT
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
