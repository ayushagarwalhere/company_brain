# Copy to .env and fill in. Never commit .env.

# FalkorDB Cloud (from the instance's "Connect" panel)
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=company_brain

# Slack app with Socket Mode
# Bot token (xoxb-...): OAuth & Permissions page
#   scopes: channels:history, channels:read, chat:write, chat:write.customize, users:read, app_mentions:read
#   events (Event Subscriptions, Socket Mode): message.channels, app_mention
# App token (xapp-...): Basic Information > App-Level Tokens, scope connections:write
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_CHANNEL_ID=
# "Add to Slack" on the website (any workspace): Basic Information > App Credentials, and add
# <PUBLIC_URL>/api/connect/slack/callback under OAuth & Permissions > Redirect URLs (HTTPS)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PUBLIC_URL=

# Discord bot (Message Content Intent enabled; invite with Send Messages, Read Message History, Manage Webhooks)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# "Add to Discord" on the website: the application id (General Information); read from the bot token when unset
DISCORD_CLIENT_ID=
# role changes as they happen (also switch on the Server Members intent in the Developer Portal)
DISCORD_MEMBERS_INTENT=
# connected teams: seconds between sync passes (people, GitHub, re-resolve); 0 = off
TEAM_SYNC_SECONDS=300
# "Try it on your repo" (pipeline/tryrepo.py): window, cache and the repo built at startup; GITHUB_TOKEN raises
# GitHub's limit from 60 to 5,000 calls an hour (a token with public-repo read access is enough)
TRY_ISSUES=150
TRY_PRS=100
TRY_TTL_HOURS=12
TRY_PREWARM=FalkorDB/FalkorDB
# MCP over stdio (python -m agent.mcp_server): the org's graph and the viewer; the hosted /mcp reads X-Org / X-User
BRAIN_ORG=
BRAIN_USER=

# GitHub: public repo for the fictional company + a fine-grained PAT
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- API hardening (all optional; unset = open local demo) ---
# Shared secret for write endpoints (/api/ingest/*, /api/demo/reset): send as X-Ingest-Token or Authorization: Bearer
INGEST_TOKEN=
# GitHub webhook secret: /api/ingest/github verifies X-Hub-Signature-256 when set
GITHUB_WEBHOOK_SECRET=
# Comma-separated origins allowed to call the API from a browser (only needed if the UI is served elsewhere)
CORS_ORIGINS=
# Requests per minute per client for /api/ask, /api/simulate, /api/spec (default 30)
RATE_LIMIT_PER_MIN=

# Any OpenAI-compatible LLM instead of DeepSeek (optional). Local and free with Ollama:
#   ollama pull qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
# LLM_REASONING_EFFORT=none
